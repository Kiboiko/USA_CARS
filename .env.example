# ---- Core ----
# SQLite database file (created on first run). Use ":memory:" only for throwaway.
DATABASE_PATH=data/app.db

# Secret for signing admin JWTs. REQUIRED. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Admin token lifetime (jose duration syntax: "12h", "7d", "30m").
JWT_EXPIRES_IN=12h

# ---- Uploads ----
UPLOAD_DIR=public/uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_UPLOAD_BYTES=5242880

# ---- Admin seed logins (used by `npm run db:seed`) ----
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=

# ---- Email (Titan SMTP, ТЗ §4) ----
# If host/user/password are empty, lead emails are skipped (lead still saved).
# Exact host/port: Webmail → Settings → Configure 3rd party apps.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEADS_EMAIL_TO=

# ---- Google Sheets (service account, ТЗ §4) ----
# If any of the three are empty, Sheets append is skipped (lead still saved).
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A:G
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n escapes (they are converted at runtime).
GOOGLE_PRIVATE_KEY=

# ---- Frontend (Role 2) ----
# Backend and frontend now ship as ONE Next.js app, so the API is same-origin —
# leave this empty. Set it only if the frontend is deployed separately from the API.
NEXT_PUBLIC_API_BASE_URL=

# Public site URL — used for SEO (sitemap, canonical, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
