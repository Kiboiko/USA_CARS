# Base URL of the backend API (Role 1). Leave empty to use the built-in
# mock API routes under /app/api (same origin). Set this when the real
# backend is ready, e.g. https://api.example.com
NEXT_PUBLIC_API_BASE_URL=

# Public site URL — used for SEO (sitemap, canonical, OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
