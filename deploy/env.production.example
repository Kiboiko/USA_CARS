# Production environment for the VPS. Copy to the project root as ".env" on the
# server and fill in real values. Do NOT commit this file with secrets.
#
# IMPORTANT: NEXT_PUBLIC_* values are baked in at BUILD time — set them before
# running `npm run build` on the server.

NODE_ENV=production
PORT=3000

# Public site URL (used for SEO/sitemap/canonical). Must match the real domain.
NEXT_PUBLIC_SITE_URL=https://pro-autohub.com

# Database + uploads (relative to the project dir; created on first run).
DATABASE_PATH=data/app.db
UPLOAD_DIR=public/uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_UPLOAD_BYTES=5242880

# REQUIRED. Generate a long random string, e.g.:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Admin logins (used once by `npm run db:seed`). Use strong passwords.
ADMIN1_USERNAME=admin
ADMIN1_PASSWORD=
ADMIN2_USERNAME=
ADMIN2_PASSWORD=

# ---- Google Sheets (client's service account — see docs/SETUP_CLIENT.md) ----
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A:G
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Email notifications via Resend (see docs/SETUP_CLIENT.md) ----
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
LEADS_EMAIL_TO=
